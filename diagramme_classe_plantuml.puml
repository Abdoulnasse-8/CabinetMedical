  + updateDossierMedical(Long patientId, DossierMedical dossier) : DossierMedical
}

class CabinetService SERVICE_COLOR {
  - CabinetRepository cabinetRepository
  - UtilisateurRepository utilisateurRepository
  - PasswordEncoder passwordEncoder
  --
  + getAllCabinets() : List<Cabinet>
  + getActiveCabinets() : List<Cabinet>
  + getCabinetById(Long id) : Cabinet
  + createCabinet(Cabinet cabinet) : Cabinet
  + updateCabinet(Long id, Cabinet cabinet) : Cabinet
  + toggleCabinetStatus(Long id) : Cabinet
  + deleteCabinet(Long id) : void
  + createUtilisateurForCabinet(Long cabinetId, Utilisateur utilisateur) : Utilisateur
  + getUtilisateursByCabinet(Long cabinetId) : List<Utilisateur>
