}

class MedicamentService SERVICE_COLOR {
  - MedicamentRepository medicamentRepository
  --
  + getAllMedicaments() : List<Medicament>
  + getMedicamentById(Long id) : Medicament
  + searchMedicaments(String search) : List<Medicament>
  + createMedicament(Medicament medicament) : Medicament
  + createMedicaments(List<Medicament> medicaments) : List<Medicament>
  + updateMedicament(Long id, Medicament medicament) : Medicament
