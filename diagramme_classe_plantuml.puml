@startuml Diagramme_Classes_Cabinet_Medical

!define ENTITY_COLOR #E3F2FD
!define DTO_COLOR #E8F5E9
!define REPO_COLOR #FFF9C4
!define SERVICE_COLOR #FFE0B2
!define CONTROLLER_COLOR #FCE4EC
!define SECURITY_COLOR #FFCDD2
!define CONFIG_COLOR #F5F5F5
!define ENUM_COLOR #E1BEE7

skinparam class {
  BackgroundColor ENTITY_COLOR
  ArrowColor #1976D2
  BorderColor #1976D2
}

' ============================================
' ENUMS
' ============================================
enum Role ENUM_COLOR {
  MEDECIN
  SECRETAIRE
  ADMINISTRATEUR
}

enum StatutRendezVous ENUM_COLOR {
  CONFIRME
  ANNULE
  EN_ATTENTE
  TERMINE
}

enum StatutFacture ENUM_COLOR {
  PAYEE
  NON_PAYEE
  PARTIELLEMENT_PAYEE
}

enum ModePaiement ENUM_COLOR {
  ESPECES
  CARTE
  ASSURANCE
}

enum TypeConsultation ENUM_COLOR {
  CONSULTATION
  CONTROLE
}

' ============================================
' ENTITIES
' ============================================
class Cabinet ENTITY_COLOR {
  - Long id {PK}
  - String logo {LONGTEXT}
  - String nom {NOT NULL}
  - String specialite
  - String adresse
  - String tel
  - Boolean actif {NOT NULL, default=true}
  --
  + Table: cabinets
}

class Utilisateur ENTITY_COLOR {
  - Long id {PK}
  - String login {UNIQUE, NOT NULL}
  - String pwd {NOT NULL, WRITE_ONLY}
  - String nom {NOT NULL}
  - String prenom {NOT NULL}
  - String numTel
  - String signature {TEXT}
  - Role role {NOT NULL}
  --
  + Cabinet cabinet {ManyToOne}
  + List<Consultation> consultations {OneToMany}
  + List<RendezVous> rendezVous {OneToMany}
  + Table: utilisateurs
}

class Patient ENTITY_COLOR {
  - Long id {PK}
  - String cin {UNIQUE, NOT NULL}
  - String nom {NOT NULL}
  - String prenom {NOT NULL}
  - LocalDate dateNaissance
  - String sexe
  - String numTel
  - String typemutuelle
  --
  + Cabinet cabinet {ManyToOne, LAZY}
  + DossierMedical dossierMedical {OneToOne, LAZY}
  + List<RendezVous> rendezVous {OneToMany, LAZY}
  + List<Facture> factures {OneToMany, LAZY}
  + Table: patients
}

class RendezVous ENTITY_COLOR {
  - Long idRendezVous {PK}
  - LocalDate dateRdv {NOT NULL}
  - LocalTime heureRdv {NOT NULL}
  - String motif
  - StatutRendezVous statut {NOT NULL, default=EN_ATTENTE}
  - String notes {TEXT}
  --
  + Patient patient {ManyToOne, NOT NULL, LAZY}
  + Utilisateur medecin {ManyToOne, NOT NULL, LAZY}
  + Cabinet cabinet {ManyToOne, LAZY}
  + Consultation consultation {OneToOne, LAZY}
  + Table: rendez_vous
}

class Consultation ENTITY_COLOR {
  - Long idConsultation {PK}
  - TypeConsultation type {NOT NULL}
  - LocalDate dateConsultation {NOT NULL}
  - String examenClinique {TEXT}
  - String examenSupplementaire {TEXT}
  - String diagnostic {TEXT}
  - String traitement {TEXT}
  - String observations {TEXT}
  --
  + Utilisateur medecin {ManyToOne, NOT NULL, LAZY}
  + Patient patient {ManyToOne, NOT NULL, LAZY}
  + DossierMedical dossierMedical {ManyToOne, LAZY}
  + RendezVous rendezVous {OneToOne, LAZY}
  + Table: consultations
}

class Facture ENTITY_COLOR {
  - Long idFacture {PK}
  - BigDecimal montant {NOT NULL}
  - ModePaiement modePaiement {NOT NULL}
  - StatutFacture statut {NOT NULL, default=NON_PAYEE}
  - LocalDateTime dateCreation {NOT NULL}
  --
  + Patient patient {ManyToOne, NOT NULL, LAZY}
  + Cabinet cabinet {ManyToOne, LAZY}
  + Consultation consultation {OneToOne, LAZY}
  + Table: factures
}

class DossierMedical ENTITY_COLOR {
  - Long idDossier {PK}
  - String antMedicaux {TEXT}
  - String antChirug {TEXT}
  - String allergies {TEXT}
  - String traitement {TEXT}
  - String habitudes {TEXT}
  - String documentsMedicaux {TEXT}
  - LocalDateTime dateCreation {NOT NULL}
  --
  + Patient patient {OneToOne, UNIQUE, NOT NULL, LAZY}
  + List<Consultation> historiqueConsultations {OneToMany, LAZY}
  + Table: dossiers_medicaux
}

class Medicament ENTITY_COLOR {
  - Long id {PK}
  - String nom {UNIQUE, NOT NULL}
  - String dosage
  - String forme
  - String description {TEXT}
  --
  + Table: medicaments
}

' ============================================
' DTOs
' ============================================
class AuthRequest DTO_COLOR {
  + String login
  + String pwd
}

class AuthResponse DTO_COLOR {
  + String token
  + String login
  + String role
  + Long userId
  + Long cabinetId
  + String nom
  + String prenom
}

class UserDto DTO_COLOR {
  + Long id
  + String login
  + String nom
  + String prenom
  + String numTel
  + String signature
  + Role role
  + Long cabinetId
}

class UserMeDto DTO_COLOR {
  + Long id
  + String login
  + String nom
  + String prenom
  + String role
  + Long cabinetId
}

class UpdateProfileRequest DTO_COLOR {
  + String nom
  + String prenom
}

' ============================================
' REPOSITORIES
' ============================================
interface JpaRepository<T, ID> REPO_COLOR {
  + save(T entity) : T
  + findById(ID id) : Optional<T>
  + findAll() : List<T>
  + deleteById(ID id) : void
  + delete(T entity) : void
}

interface UtilisateurRepository REPO_COLOR {
  + findByLogin(String login) : Optional<Utilisateur>
  + findByCabinetId(Long cabinetId) : List<Utilisateur>
  + findByRole(Role role) : List<Utilisateur>
  + findByCabinetIdAndRole(Long cabinetId, Role role) : List<Utilisateur>
}

interface PatientRepository REPO_COLOR {
  + findByCin(String cin) : Optional<Patient>
  + findByCabinetId(Long cabinetId) : List<Patient>
  + searchPatients(Long cabinetId, String search) : List<Patient>
}

interface CabinetRepository REPO_COLOR {
  + findByActifTrue() : List<Cabinet>
}

interface RendezVousRepository REPO_COLOR {
  + findByPatientId(Long patientId) : List<RendezVous>
  + findByMedecinId(Long medecinId) : List<RendezVous>
  + findByCabinetId(Long cabinetId) : List<RendezVous>
  + findByDateRdvAndMedecinId(LocalDate date, Long medecinId) : List<RendezVous>
  + findByStatut(StatutRendezVous statut) : List<RendezVous>
  + findTodayByCabinet(Long cabinetId, LocalDate today) : List<RendezVous>
  + findConflictingRendezVous(LocalDate date, LocalTime heure, Long medecinId) : List<RendezVous>
  + findTodayRendezVousByMedecin(LocalDate date, Long medecinId) : List<RendezVous>
  + findByCabinetIdWithPatient(Long cabinetId) : List<RendezVous>
  + findByCabinetIdWithDetails(Long cabinetId) : List<RendezVous>
  + findTodayRendezVousByMedecinWithDetails(LocalDate date, Long medecinId) : List<RendezVous>
}

interface ConsultationRepository REPO_COLOR {
  + findByPatientId(Long patientId) : List<Consultation>
  + findByMedecinId(Long medecinId) : List<Consultation>
}

interface FactureRepository REPO_COLOR {
  + findByPatientId(Long patientId) : List<Facture>
  + findByCabinetId(Long cabinetId) : List<Facture>
  + findByStatut(StatutFacture statut) : List<Facture>
}

interface DossierMedicalRepository REPO_COLOR {
  + findByPatientId(Long patientId) : Optional<DossierMedical>
}

interface MedicamentRepository REPO_COLOR {
  + findByNomContainingIgnoreCase(String search) : List<Medicament>
}

' ============================================
' SERVICES
' ============================================
class AuthService SERVICE_COLOR {
  - UtilisateurRepository utilisateurRepository
  - JwtUtil jwtUtil
  - PasswordEncoder passwordEncoder
  --
  + authenticate(AuthRequest request) : AuthResponse
}

class PatientService SERVICE_COLOR {
  - PatientRepository patientRepository
  - DossierMedicalRepository dossierMedicalRepository
  --
  + getAllPatients(Long cabinetId) : List<Patient>
  + getPatientById(Long id) : Patient
  + getPatientByCin(String cin) : Patient
  + searchPatients(Long cabinetId, String search) : List<Patient>
  + createPatient(Patient patient, Long cabinetId) : Patient
  + updatePatient(Long id, Patient patient) : Patient
  + deletePatient(Long id) : void
}

class RendezVousService SERVICE_COLOR {
  - RendezVousRepository rendezVousRepository
  - PatientRepository patientRepository
  - UtilisateurRepository utilisateurRepository
  - CabinetRepository cabinetRepository
  --
  + getAllRendezVous(Long cabinetId) : List<RendezVous>
  + getRendezVousById(Long id) : RendezVous
  + getRendezVousByPatient(Long patientId) : List<RendezVous>
  + getTodayRendezVousByMedecin(Long medecinId) : List<RendezVous>
  + getTodayRendezVousByCabinet(Long cabinetId) : List<RendezVous>
  + createRendezVous(RendezVous rdv, Long patientId, Long medecinId, Long cabinetId) : RendezVous
  + updateRendezVous(Long id, RendezVous rdv) : RendezVous
  + updateStatutRendezVous(Long id, StatutRendezVous statut) : RendezVous
  + deleteRendezVous(Long id) : void
}

class ConsultationService SERVICE_COLOR {
  - ConsultationRepository consultationRepository
  - DossierMedicalRepository dossierMedicalRepository
  - RendezVousRepository rendezVousRepository
  - PatientRepository patientRepository
  - UtilisateurRepository utilisateurRepository
  --
  + getConsultationsByPatient(Long patientId) : List<Consultation>
  + getConsultationById(Long id) : Consultation
  + createConsultation(Consultation consultation, Long patientId, Long medecinId, Long rendezVousId) : Consultation
  + updateConsultation(Long id, Consultation consultation) : Consultation
  + deleteConsultation(Long id) : void
}

class FactureService SERVICE_COLOR {
  - FactureRepository factureRepository
  - PatientRepository patientRepository
  - CabinetRepository cabinetRepository
  - ConsultationRepository consultationRepository
  --
  + getAllFactures(Long cabinetId) : List<Facture>
  + getFactureById(Long id) : Facture
  + getFacturesByPatient(Long patientId) : List<Facture>
  + createFacture(Facture facture, Long patientId, Long cabinetId, Long consultationId) : Facture
  + updateFacture(Long id, Facture facture) : Facture
  + updateStatutFacture(Long id, StatutFacture statut) : Facture
  + deleteFacture(Long id) : void
}

class DossierMedicalService SERVICE_COLOR {
