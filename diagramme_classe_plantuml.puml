' ============================================
' SECURITY
' ============================================
class JwtUtil SECURITY_COLOR {
  - String secret
  - Long expiration
  --
  + generateToken(String login, String role, Long userId, Long cabinetId) : String
  + extractUsername(String token) : String
  + extractRole(String token) : String
  + extractUserId(String token) : Long
  + extractCabinetId(String token) : Long
  + validateToken(String token, String username) : Boolean
  + extractExpiration(String token) : Date
}

class JwtRequestFilter SECURITY_COLOR {
  - JwtUtil jwtUtil
  - CustomUserDetailsService userDetailsService
  --
  + doFilterInternal(HttpServletRequest, HttpServletResponse, FilterChain) : void
}

' ============================================
' CONFIGURATION
' ============================================
class SecurityConfig CONFIG_COLOR {
  - JwtRequestFilter jwtRequestFilter
  --
  + SecurityFilterChain filterChain(HttpSecurity) : SecurityFilterChain
  + CorsConfigurationSource corsConfigurationSource() : CorsConfigurationSource
  + PasswordEncoder passwordEncoder() : BCryptPasswordEncoder
  + AuthenticationManager authenticationManager(AuthenticationConfiguration) : AuthenticationManager
}

class JacksonConfig CONFIG_COLOR {
  + ObjectMapper objectMapper() : ObjectMapper
}

class DataInitializer CONFIG_COLOR {
  - CabinetRepository cabinetRepository
  - UtilisateurRepository utilisateurRepository
  - PasswordEncoder passwordEncoder
  - MedicamentRepository medicamentRepository
  --
  + run(ApplicationArguments) : void
  + initializeData() : void
}

class CabinetMedicalApplication CONFIG_COLOR {
  + main(String[] args) : void
}

' ============================================
' RELATIONS ENTITIES
' ============================================
Utilisateur "1" --> "0..*" Consultation : medecin
Utilisateur "1" --> "0..*" RendezVous : medecin
Utilisateur "*" --> "1" Cabinet : cabinet

Patient "1" --> "1" DossierMedical : dossierMedical
Patient "1" --> "0..*" RendezVous : patient
Patient "1" --> "0..*" Facture : factures
Patient "*" --> "1" Cabinet : cabinet

RendezVous "1" --> "0..1" Consultation : consultation
RendezVous "*" --> "1" Patient : patient
RendezVous "*" --> "1" Utilisateur : medecin
RendezVous "*" --> "1" Cabinet : cabinet

Consultation "*" --> "1" Utilisateur : medecin
Consultation "*" --> "1" Patient : patient
Consultation "*" --> "1" DossierMedical : dossierMedical
Consultation "1" --> "0..1" RendezVous : rendezVous

Facture "*" --> "1" Patient : patient
Facture "*" --> "1" Cabinet : cabinet
Facture "1" --> "0..1" Consultation : consultation

DossierMedical "1" --> "0..*" Consultation : historiqueConsultations

' Relations avec énumérations
Utilisateur ..> Role : uses
RendezVous ..> StatutRendezVous : uses
Facture ..> ModePaiement : uses
Facture ..> StatutFacture : uses
Consultation ..> TypeConsultation : uses

' ============================================
' RELATIONS REPOSITORIES - JPA
' ============================================
UtilisateurRepository --|> JpaRepository
PatientRepository --|> JpaRepository
CabinetRepository --|> JpaRepository
RendezVousRepository --|> JpaRepository
ConsultationRepository --|> JpaRepository
FactureRepository --|> JpaRepository
DossierMedicalRepository --|> JpaRepository
MedicamentRepository --|> JpaRepository

